{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/pesca-del-atun/(.*)", "destination": "/pesca-del-atun-marbella/", "permanent": true },
    { "source": "/pesca-al-jigging/(.*)", "destination": "/pesca-al-jigging-marbella/", "permanent": true },
    { "source": "/pesca-del-calamar/(.*)", "destination": "/pesca-del-calamar-marbella/", "permanent": true },
    { "source": "/pesca-de-fondo/(.*)", "destination": "/pesca-de-fondo-marbella/", "permanent": true },
    { "source": "/pesca-al-vivo/(.*)", "destination": "/pesca-al-vivo-marbella/", "permanent": true },
    { "source": "/pesca-al-currican/(.*)", "destination": "/pesca-al-currican-marbella/", "permanent": true },
    { "source": "/en/tuna-fishing/(.*)", "destination": "/en/tuna-fishing-marbella/", "permanent": true },
    { "source": "/en/jigging/(.*)", "destination": "/en/jigging-marbella/", "permanent": true },
    { "source": "/en/squid-fishing/(.*)", "destination": "/en/squid-fishing-marbella/", "permanent": true },
    { "source": "/en/bottom-fishing/(.*)", "destination": "/en/bottom-fishing-marbella/", "permanent": true },
    { "source": "/en/live-bait-fishing/(.*)", "destination": "/en/live-bait-fishing-marbella/", "permanent": true },
    { "source": "/en/trolling/(.*)", "destination": "/en/trolling-marbella/", "permanent": true },
    { "source": "/es", "destination": "/", "statusCode": 301 },
    { "source": "/es/", "destination": "/", "statusCode": 301 },
    { "source": "/es/contactar", "destination": "/contactar/", "statusCode": 301 },
    { "source": "/es/contactar/", "destination": "/contactar/", "statusCode": 301 },
    { "source": "/es/(.*)", "destination": "/", "statusCode": 301 },
    { "source": "/contact-us", "destination": "/en/contact/", "statusCode": 301 },
    { "source": "/contact-us/", "destination": "/en/contact/", "statusCode": 301 },
    { "source": "/sitemap_index.xml", "destination": "/sitemap.xml", "statusCode": 301 },
    { "source": "/page-sitemap.xml", "destination": "/sitemap.xml", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(.*)\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
